# Copy to .env and edit. QWEN_TTS_MODEL is REQUIRED — the container refuses to start without it.
# Pick ONE model id (weights are downloaded into the /models volume on first start):
#
#   Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice   preset speakers + instruct control (heavier VRAM)
#   Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice   lighter, no instruct support
#   Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign   describe the voice in natural language
#   Qwen/Qwen3-TTS-12Hz-1.7B-Base          voice cloning via POST /v1/audio/clone
#   Qwen/Qwen3-TTS-12Hz-0.6B-Base          voice cloning, lighter
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice

QWEN_TTS_DEVICE=cuda:0
QWEN_TTS_ATTN=sdpa
QWEN_TTS_VOICE=Ryan
QWEN_TTS_PORT=3447

# Optional:
# QWEN_TTS_DTYPE=bfloat16
# QWEN_TTS_VOICE_MAP={"Ava":"Ryan"}
# QWEN_TTS_TEMPERATURE=0.7
# QWEN_TTS_TOP_P=0.8
# QWEN_TTS_TOP_K=20
# QWEN_TTS_REPETITION_PENALTY=1.1
# QWEN_TTS_MAX_NEW_TOKENS=2048
